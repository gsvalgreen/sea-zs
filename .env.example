# Copie para .env (ignorado pelo git): cp .env.example .env
# Valores de desenvolvimento local, alinhados com src/main/resources/application.properties.
MYSQL_ROOT_PASSWORD=system
MYSQL_DATABASE=seazs
MYSQL_PORT=3306

# Hoje: 5.7 (exigido por mysql-connector-java 5.1.46 e MySQL5InnoDBDialect).
# Alvo do plano de modernizacao: 8.4 (ao migrar, troque tambem MYSQL_EXTRA_ARGS e MYSQL_PLATFORM).
MYSQL_VERSION=5.7
MYSQL_PLATFORM=linux/amd64
MYSQL_EXTRA_ARGS=--ssl=0
