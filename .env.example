# Copie para .env (ignorado pelo git): cp .env.example .env
# Valores de desenvolvimento local, alinhados com src/main/resources/application.properties.
MYSQL_ROOT_PASSWORD=system
MYSQL_DATABASE=seazs
MYSQL_PORT=3306

# MySQL 8.4 (LTS), compativel com o driver mysql-connector-j e o dialeto MySQL8 do Hibernate.
MYSQL_VERSION=8.4
