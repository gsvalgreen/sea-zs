# Copie para .env (ignorado pelo git): cp .env.example .env
# Valores de desenvolvimento local, alinhados com src/main/resources/application.properties.
MYSQL_ROOT_PASSWORD=system
MYSQL_DATABASE=seazs
MYSQL_PORT=3306

# MySQL 8.4 (LTS), compativel com o driver mysql-connector-j e o dialeto MySQL8 do Hibernate.
MYSQL_VERSION=8.4

# Seguranca: JWT_SECRET e OBRIGATORIO para rodar a aplicacao (export no shell; NAO coloque o valor real em arquivos versionados).
# Gere com: openssl rand -base64 48   (minimo 32 bytes). Opcionais: JWT_ISSUER, JWT_ACCESS_TTL=PT15M, JWT_REFRESH_TTL=P7D, CORS_ALLOWED_ORIGINS=http://localhost:4200
# JWT_SECRET=
